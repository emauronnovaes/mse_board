# ==========================================
# MSE Board — Modelo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os valores reais.
#   PowerShell:  Copy-Item .env.example .env
# O ".env" é ignorado pelo Git; este ".env.example" é versionado.
# ==========================================

# --- Banco de dados (MySQL) ---
DB_HOST=localhost
DB_NAME=mse_board
DB_USER=root
DB_PASS=

# --- Segredos da API ---
# Gere um valor aleatório longo. O frontend usa a MESMA chave (via config.js.php).
API_SECRET=troque-por-uma-chave-secreta-longa

# Token separado só para o webhook de sugestões.
SUGGESTIONS_WEBHOOK_TOKEN=troque-por-um-token

# --- Configuração HTTP ---
ALLOWED_ORIGIN=http://localhost
API_BASE=http://localhost/mse_board/mse-backend/api

# --- SSO (login herdado via iframe do Portal MSE) ---
# DEVE ser a MESMA chave usada pelo portal que gera o token (Codigo.gs / PHP).
SUPER_APP_SSO_SECRET=troque-por-uma-chave-igual-a-do-portal-com-64-chars
SUPER_APP_SSO_TTL_SEGUNDOS=60
